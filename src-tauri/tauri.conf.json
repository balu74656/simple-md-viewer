{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "MD Viewer",
  "version": "0.8.0",
  "identifier": "io.github.balu74656.mdviewer",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "MD Viewer",
        "width": 1280,
        "height": 860,
        "minWidth": 640,
        "minHeight": 420,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data:; script-src 'self'; connect-src 'self' https: http:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "icons/filetypes/md.ico": "filetypes/md.ico",
      "icons/filetypes/puml.ico": "filetypes/puml.ico",
      "icons/filetypes/yaml.ico": "filetypes/yaml.ico",
      "icons/filetypes/json.ico": "filetypes/json.ico"
    },
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd"],
        "name": "Markdown Document",
        "description": "Markdown dokument",
        "role": "Editor",
        "mimeType": "text/markdown"
      },
      {
        "ext": ["puml", "plantuml", "pu", "iuml"],
        "name": "PlantUML Diagram",
        "description": "PlantUML diagram",
        "role": "Editor",
        "mimeType": "text/plain"
      },
      {
        "ext": ["yaml", "yml"],
        "name": "YAML Document",
        "description": "YAML / OpenAPI specifikace",
        "role": "Editor",
        "mimeType": "application/yaml"
      },
      {
        "ext": ["json"],
        "name": "JSON Document",
        "description": "JSON / OpenAPI specifikace",
        "role": "Editor",
        "mimeType": "application/json"
      }
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "installerHooks": "./windows/hooks.nsh",
        "languages": ["English"]
      }
    }
  }
}
